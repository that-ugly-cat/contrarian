# ── Required ──────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me            # trace viewer + key management login
JWT_SECRET=change-me-too            # cookie signing, use 32+ random chars (falls back to ADMIN_PASSWORD)
PUBLIC_URL=https://contrarian.borant.eu

# ── Full-text retrieval (all optional — unset providers are skipped) ──────────
UNPAYWALL_EMAIL=you@example.org     # polite-pool identity for Unpaywall/OpenAlex
OPENALEX_MAILTO=you@example.org
PAPER2MD_URL=http://localhost:8008  # internal address skips the Cloudflare 100s cap
PAPER2MD_API_KEY=                   # lifts paper2md's upload cap to 50MB

# Publisher TDM APIs — server-side only, never transit through clients
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=                 # from the institution's library; key alone 403s
SPRINGER_API_KEY=                   # the Open Access API key
WILEY_TDM_TOKEN=
